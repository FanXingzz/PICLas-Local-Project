{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PICLas: Build helium pulse solver",
      "type": "process",
      "command": "wsl.exe",
      "args": ["-d", "Ubuntu-24.04", "--cd", "${workspaceFolder}", "--", "bash", "./build_solver.sh"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "PICLas: Build helium mesh",
      "type": "process",
      "command": "wsl.exe",
      "args": ["-d", "Ubuntu-24.04", "--cd", "${workspaceFolder}", "--", "bash", "./build_mesh.sh"],
      "problemMatcher": []
    },
    {
      "label": "PICLas: Open workbench",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "Open-in-VSCode.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
